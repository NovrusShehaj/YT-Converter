# Copy to a local .env if you want a checklist. The binaries read process
# environment variables, not this file. Leave secrets empty here.

YTCONV_BIND=127.0.0.1
YTCONV_PORT=8080
YTCONV_LOG_LEVEL=INFO
YTCONV_LOG_FORMAT=text
YTCONV_OUTPUT_DIR=./output
YTCONV_MAX_CONCURRENT=1
YTCONV_CHILD_TIMEOUT_SEC=900
YTCONV_SOCKET_TIMEOUT_SEC=30
YTCONV_MAX_FILESIZE=500M
YTCONV_RETRIES=2
YTCONV_YT_DLP=yt-dlp
YTCONV_FFMPEG=ffmpeg
YTCONV_API_KEY=
YTCONV_ALLOW_REMOTE=
YTCONV_ALLOW_UNAUTHENTICATED_LOCALHOST=
YTCONV_LOG_URLS=
