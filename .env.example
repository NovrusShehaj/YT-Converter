[TEMPLATE]
# Copy to a local .env if you want a checklist. The binaries read process
# environment variables, not this file. Leave secrets empty here.

YTCONV_BIND=127.0.0.1
YTCONV_PORT=8080
YTCONV_LOG_LEVEL=INFO
YTCONV_LOG_FORMAT=text
YTCONV_OUTPUT_DIR=./output
YTCONV_MAX_CONCURRENT=2
# Queued plus running operations; live jobs (incl. attached) and finished-job history are separate.
YTCONV_QUEUE_DEPTH=8
YTCONV_MAX_ACTIVE_JOBS=256
YTCONV_JOB_HISTORY_MAX=1024
YTCONV_JOB_HISTORY_TTL_SEC=3600
YTCONV_REUSE_COMPLETED=1
YTCONV_SYNC_CONVERSIONS=
YTCONV_SOURCE_CACHE_TTL_SEC=86400
YTCONV_SOURCE_CACHE_MAX_BYTES=10G
YTCONV_DOWNLOAD_TIMEOUT_SEC=600
YTCONV_CONVERT_TIMEOUT_SEC=300
YTCONV_SOCKET_TIMEOUT_SEC=30
YTCONV_MAX_FILESIZE=500M
YTCONV_RETRIES=2
YTCONV_CONCURRENT_FRAGMENTS=4
YTCONV_FRAGMENT_RETRIES=10
YTCONV_MAX_HEIGHT=1080
YTCONV_YT_DLP=yt-dlp
YTCONV_FFMPEG=ffmpeg
YTCONV_API_KEY=
YTCONV_ALLOW_REMOTE=
YTCONV_ALLOW_UNAUTHENTICATED_LOCALHOST=
YTCONV_LOG_URLS=
YTCONV_READY_TTL_SEC=60
# Empty uses <output>/cache/ytdlp. A relative path is placed under the output root.
YTCONV_CACHE_DIR=
