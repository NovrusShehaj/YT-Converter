#!/usr/bin/env bash
set -euo pipefail
LOGDIR="${YTCONV_FAKE_LOG_DIR:-.}"
mkdir -p "$LOGDIR"
printf '%s\n' "$@" > "$LOGDIR/yt-dlp.argv"
echo 1 >> "$LOGDIR/yt-dlp.count"

out=""
prev=""
for arg in "$@"; do
  if [[ "$prev" == "-o" ]]; then
    out="$arg"
  fi
  prev="$arg"
done

if [[ -n "$out" ]]; then
  mkdir -p "$(dirname "$out")"
  ext="mp4"
  final_out="$out"
  if [[ "$out" == *"%(ext)s"* ]]; then
    final_out="${out//\%(ext)s/$ext}"
  fi
  # Write the file for any output path
  printf 'FAKE' > "$final_out"
fi
exit 0
