#!/usr/bin/env bash
set -euo pipefail
LOGDIR="${YTCONV_FAKE_LOG_DIR:-.}"
mkdir -p "$LOGDIR"

if [[ "${1:-}" == "--version" ]]; then
  echo 1 >> "$LOGDIR/yt-dlp.version.count"
  echo "2024.12.23-fake"
  exit 0
fi

printf '%s\n' "$@" > "$LOGDIR/yt-dlp.argv"
echo 1 >> "$LOGDIR/yt-dlp.count"

out=""
prev=""
for arg in "$@"; do
  if [[ "$prev" == "-o" ]]; then
    out="$arg"
  fi
  prev="$arg"
done

if [[ -n "${YTCONV_FAKE_SLEEP:-}" ]]; then
  sleep "$YTCONV_FAKE_SLEEP"
fi

if [[ -n "$out" ]]; then
  mkdir -p -- "$(dirname -- "$out")"
  ext="${YTCONV_FAKE_EXT:-mp4}"
  if [[ -n "${YTCONV_FAKE_SOURCE:-}" ]]; then
    # Serve a locally generated media fixture instead of placeholder bytes.
    ext="${YTCONV_FAKE_SOURCE##*.}"
  fi
  final_out="$out"
  if [[ "$out" == *"%(ext)s"* ]]; then
    final_out="${out//\%(ext)s/$ext}"
  fi
  if [[ -n "${YTCONV_FAKE_SOURCE:-}" ]]; then
    cp -- "$YTCONV_FAKE_SOURCE" "$final_out"
  else
    printf '%s' "${YTCONV_FAKE_CONTENT:-FAKE}" > "$final_out"
  fi
fi
exit 0
