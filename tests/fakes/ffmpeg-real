#!/usr/bin/env bash
# Counts invocations, then runs the real ffmpeg. Used by network-free media integration tests.
set -euo pipefail
LOGDIR="${YTCONV_FAKE_LOG_DIR:-.}"
mkdir -p "$LOGDIR"
if [[ "${1:-}" != "-version" ]]; then
  printf '%s\n' "$@" > "$LOGDIR/ffmpeg.argv"
  echo 1 >> "$LOGDIR/ffmpeg.count"
fi
exec "${YTCONV_REAL_FFMPEG:-ffmpeg}" "$@"
